@model SmartX.Client.Models.SensorViewModel

@{
    ViewData["Title"] = "Register Sensor";
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow-sm">

                <div class="card-header">
                    <h2 class="mb-0">
                        Register IoT Sensor
                    </h2>

                    <small class="text-muted">
                        Add a new device to the
                        Smart-X telemetry gateway.
                    </small>
                </div>

                <div class="card-body">

                    <form asp-action="Register"
                          method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger">
                        </div>

                        <div class="mb-3">
                            <label asp-for="DeviceName"
                                   class="form-label">
                            </label>

                            <input asp-for="DeviceName"
                                   class="form-control"
                                   placeholder="e.g. Server Room Temperature Sensor" />

                            <span asp-validation-for="DeviceName"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MacAddress"
                                   class="form-label">
                            </label>

                            <input asp-for="MacAddress"
                                   class="form-control"
                                   placeholder="AA:BB:CC:DD:EE:FF" />

                            <span asp-validation-for="MacAddress"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DeploymentLocation"
                                   class="form-label">
                            </label>

                            <input asp-for="DeploymentLocation"
                                   class="form-control"
                                   placeholder="e.g. Johannesburg Smart-X Lab" />

                            <span asp-validation-for="DeploymentLocation"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Zone"
                                   class="form-label">
                            </label>

                            <input asp-for="Zone"
                                   class="form-control"
                                   placeholder="e.g. Server Room A" />

                            <span asp-validation-for="Zone"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Category"
                                   class="form-label">
                            </label>

                            <select asp-for="Category"
                                    class="form-select">

                                <option value="">
                                    -- Select sensor category --
                                </option>

                                <option value="Temperature">
                                    Temperature
                                </option>

                                <option value="Humidity">
                                    Humidity
                                </option>

                                <option value="Environmental">
                                    Environmental
                                </option>

                                <option value="Power Consumption">
                                    Power Consumption
                                </option>

                                <option value="Pressure">
                                    Pressure
                                </option>

                                <option value="Motion">
                                    Motion
                                </option>

                                <option value="Actuator">
                                    Actuator
                                </option>

                                <option value="Other">
                                    Other
                                </option>

                            </select>

                            <span asp-validation-for="Category"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary">
                                Register Sensor
                            </button>

                            <a asp-action="Index"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}