@model SmartX.Client.Models.NetworkTopologyViewModel

@{
    ViewData["Title"] = "Network Topology";
}

<div class="container py-4">

    <div class="mb-4">
        <h2>Network Topology & Mesh Routing</h2>
        <p class="text-muted">
            Monitor the Smart-X mesh network, inspect
            connections and trace communication routes.
        </p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">
            @Model.ErrorMessage
        </div>
    }

    <!-- Visual Mesh Network Diagram -->
    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h5 class="mb-0">Visual Mesh Network</h5>
        </div>

        <div class="card-body">
            <div class="mb-3">
                <span class="badge bg-success">Gateway</span>
                <span class="badge bg-primary">Sensor</span>
                <span class="badge bg-danger">Disconnected</span>
                <span class="badge bg-info text-dark">
                    MST Connection
                </span>
            </div>

            <div id="meshDiagram"
                 style="width:100%; overflow-x:auto;">
            </div>

            <p class="text-muted small mt-3 mb-0">
                Green connections form the minimum spanning
                tree. Red dashed connections indicate failed
                links. Connection labels show simulated weights.
            </p>
        </div>
    </div>

    <!-- Network statistics -->
    <div class="row g-3 mb-4">

        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6>Total Sensors</h6>
                    <h3>@Model.TotalSensors</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6>Active Connections</h6>
                    <h3>@Model.ActiveConnections</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6>Failed Connections</h6>
                    <h3>@Model.FailedConnections</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6>MST Total Weight</h6>
                    <h3>@Model.TotalMstWeight</h3>
                </div>
            </div>
        </div>

    </div>

    <!-- Route tracing -->
    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h5 class="mb-0">MAC Address Route Tracing</h5>
        </div>

        <div class="card-body">
            <form asp-controller="NetworkTopology"
                  asp-action="Index"
                  method="get">

                <div class="row g-3">
                    <div class="col-md-5">
                        <label class="form-label">
                            Source MAC Address
                        </label>
                        <input type="text"
                               name="sourceMac"
                               value="@Model.SourceMac"
                               class="form-control"
                               placeholder="AA:BB:CC:DD:EE:01"
                               required />
                    </div>

                    <div class="col-md-5">
                        <label class="form-label">
                            Destination MAC Address
                        </label>
                        <input type="text"
                               name="destinationMac"
                               value="@Model.DestinationMac"
                               class="form-control"
                               placeholder="AA:BB:CC:DD:EE:02"
                               required />
                    </div>

                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit"
                                class="btn btn-primary w-100">
                            Trace Route
                        </button>
                    </div>
                </div>
            </form>

            @if (Model.RouteFound == true)
            {
                <div class="alert alert-success mt-3">
                    Route found!
                    Total hops: @(Model.Route.Count - 1)
                </div>

                <ol class="list-group list-group-numbered">
                    @foreach (var node in Model.Route)
                    {
                        <li class="list-group-item">
                            <strong>@node.DeviceName</strong>
                            <span class="text-muted">
                                (@node.MacAddress)
                            </span>
                        </li>
                    }
                </ol>
            }
            else if (Model.RouteFound == false)
            {
                <div class="alert alert-warning mt-3">
                    No active route exists between these sensors.
                </div>
            }
        </div>
    </div>

    <!-- Registered mesh sensors -->
    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h5 class="mb-0">Mesh Network Devices</h5>
        </div>

        <div class="card-body table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Sensor ID</th>
                        <th>Device</th>
                        <th>MAC Address</th>
                        <th>Zone</th>
                        <th>Status</th>
                        <th>Role</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var node in Model.Nodes)
                    {
                        <tr>
                            <td>@node.SensorId</td>
                            <td>@node.DeviceName</td>
                            <td>@node.MacAddress</td>
                            <td>@node.Zone</td>
                            <td>@node.Status</td>
                            <td>
                                @(node.IsGateway
                                                            ? "Gateway"
                                                            : "Sensor")
                        </td>

                            <td>
                                <a asp-controller="TelemetryHistory"
                                   asp-action="Index"
                                   asp-route-sensorId="@node.SensorId"
                                   class="btn btn-sm btn-outline-primary">
                                    View History
                                </a>
                            </td>

                    </tr>
                                        }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Mesh connections -->
    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h5 class="mb-0">Network Connections</h5>
        </div>

        <div class="card-body table-responsive">
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Source</th>
                        <th>Destination</th>
                        <th>Weight</th>
                        <th>Status</th>
                        <th>In MST</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var edge in Model.Edges)
                    {
                        <tr>
                            <td>@edge.SourceSensorId</td>
                            <td>@edge.DestinationSensorId</td>
                            <td>@edge.Weight</td>
                            <td>
                                @(edge.IsActive
                                                            ? "Active"
                                                            : "Failed")
                                                                   </td>
                                                                   <td>
                                @(edge.IsInMinimumSpanningTree
                                                            ? "Yes"
                                                            : "No")
                        </td>

                            <td>
                            @if (edge.IsActive)
                                {
                                    <form asp-controller="NetworkTopology"
                                          asp-action="FailConnection"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="sourceId"
                                               value="@edge.SourceSensorId" />

                                        <input type="hidden"
                                               name="destinationId"
                                               value="@edge.DestinationSensorId" />

                                        <button type="submit"
                                                class="btn btn-sm btn-danger">
                                            Simulate Failure
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-controller="NetworkTopology"
                                          asp-action="RestoreConnection"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="sourceId"
                                               value="@edge.SourceSensorId" />

                                        <input type="hidden"
                                               name="destinationId"
                                               value="@edge.DestinationSensorId" />

                                        <button type="submit"
                                                class="btn btn-sm btn-success">
                                            Restore Connection
                                        </button>
                                    </form>
                                }
                            </td>

                    </tr>
                                        }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Minimum spanning tree -->
    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h5 class="mb-0">
                Prim's Minimum Spanning Tree
            </h5>
        </div>

        <div class="card-body">
            <p>
                Total connection weight:
                <strong>@Model.TotalMstWeight</strong>
            </p>

            <ul class="list-group">
                @foreach (var edge in Model.MinimumSpanningTree)
                {
                    <li class="list-group-item">
                        Sensor @edge.SourceSensorId
                        →
                        Sensor @edge.DestinationSensorId
                        (Weight: @edge.Weight)
                    </li>
                }
            </ul>
        </div>
    </div>

    <!-- Unreachable sensors -->
    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h5 class="mb-0">Unreachable Sensors</h5>
        </div>

        <div class="card-body">
            @if (Model.UnreachableSensors.Any())
            {
                <ul class="list-group">
                    @foreach (var node in Model.UnreachableSensors)
                    {
                        <li class="list-group-item">
                            @node.DeviceName
                            (@node.MacAddress)
                        </li>
                    }
                </ul>
            }
            else
            {
                <div class="alert alert-success mb-0">
                    All sensors are reachable from the gateway.
                </div>
            }
        </div>
    </div>

</div>


@using System.Text.Json

@{
    var meshNodesJson = JsonSerializer.Serialize(
        Model.Nodes);

    var meshEdgesJson = JsonSerializer.Serialize(
        Model.Edges);
}

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const nodes = @Html.Raw(meshNodesJson);
        const edges = @Html.Raw(meshEdgesJson);

        const container =
            document.getElementById("meshDiagram");

        if (!container) return;

        if (nodes.length === 0) {
            container.textContent =
                "No sensors are currently registered.";
            return;
        }

        const width = 900;
        const height = 480;

        const centerX = width / 2;
        const centerY = height / 2;

        const radius = Math.min(width, height) * 0.34;

        const positions = {};

        // Arrange sensors around a circle.
        nodes.forEach((node, index) => {

            const angle =
                (2 * Math.PI * index / nodes.length)
                - Math.PI / 2;

            positions[node.SensorId] = {
                x: centerX + radius * Math.cos(angle),
                y: centerY + radius * Math.sin(angle)
            };
        });

        const svgNS = "http://www.w3.org/2000/svg";

        const svg = document.createElementNS(svgNS, "svg");

        svg.setAttribute("viewBox", `0 0 ${width} ${height}`);
        svg.setAttribute("width", "100%");
        svg.setAttribute("role", "img");
        svg.setAttribute(
            "aria-label",
            "Smart-X mesh network topology diagram"
        );

        // Helper to create SVG elements.
        function createSvgElement(type, attributes) {

            const element =
                document.createElementNS(svgNS, type);

            Object.entries(attributes).forEach(
                ([key, value]) => {
                    element.setAttribute(key, value);
                }
            );

            return element;
        }

        // Draw network connections first.
        edges.forEach(edge => {

            const source =
                positions[edge.SourceSensorId];

            const destination =
                positions[edge.DestinationSensorId];

            if (!source || !destination) return;

            const line = createSvgElement("line", {
                x1: source.x,
                y1: source.y,
                x2: destination.x,
                y2: destination.y,
                stroke: !edge.IsActive
                    ? "#dc3545"
                    : edge.IsInMinimumSpanningTree
                        ? "#198754"
                        : "#adb5bd",
                "stroke-width":
                    edge.IsInMinimumSpanningTree ? 4 : 2,
                "stroke-dasharray":
                    edge.IsActive ? "none" : "8,6"
            });

            svg.appendChild(line);

            // Show connection weight.
            const weightLabel =
                createSvgElement("text", {
                    x: (source.x + destination.x) / 2,
                    y: (source.y + destination.y) / 2 - 8,
                    "text-anchor": "middle",
                    "font-size": "13",
                    fill: "#495057"
                });

            weightLabel.textContent = edge.Weight;

            svg.appendChild(weightLabel);
        });

        // Draw sensors on top of connections.
        nodes.forEach(node => {

            const position = positions[node.SensorId];

            let nodeColor = "#0d6efd";

            if (node.IsGateway) {
                nodeColor = "#198754";
            }

            if (node.Status === "Disconnected") {
                nodeColor = "#dc3545";
            }

            const circle = createSvgElement("circle", {
                cx: position.x,
                cy: position.y,
                r: 24,
                fill: nodeColor,
                stroke: "#ffffff",
                "stroke-width": 3
            });

            svg.appendChild(circle);

            const idLabel = createSvgElement("text", {
                x: position.x,
                y: position.y + 5,
                "text-anchor": "middle",
                "font-size": "14",
                "font-weight": "bold",
                fill: "#ffffff"
            });

            idLabel.textContent = node.SensorId;
            svg.appendChild(idLabel);

            const nameLabel = createSvgElement("text", {
                x: position.x,
                y: position.y + 43,
                "text-anchor": "middle",
                "font-size": "13",
                fill: "#212529"
            });

            nameLabel.textContent =
                node.DeviceName || `Sensor ${node.SensorId}`;

            svg.appendChild(nameLabel);

            // Show details when hovering over a node.
            const title = createSvgElement("title", {});

            title.textContent =
                `${node.DeviceName}\n` +
                `MAC: ${node.MacAddress}\n` +
                `Status: ${node.Status}\n` +
                `Zone: ${node.Zone}`;

            circle.appendChild(title);
        });

        container.replaceChildren(svg);
    });
</script>
