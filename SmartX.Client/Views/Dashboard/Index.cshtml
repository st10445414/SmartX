@model SmartX.Client.Models.DashboardViewModel

@{
    ViewData["Title"] = "Smart-X Dashboard";
}

<div class="container-fluid mt-4">

    <div class="mb-4">
        <h2>Smart-X Sensor Health Dashboard</h2>

        <p class="text-muted">
            Real-time overview of connected devices,
            warning states and sensor connectivity.
        </p>
    </div>

    <div class="d-flex
            justify-content-between
            align-items-center
            mb-4">

        <div>
            <h2>
                Smart-X Sensor Health Dashboard
            </h2>

            <p class="text-muted mb-0">
                Real-time overview of sensor
                connectivity and anomaly states.
            </p>
        </div>

        <div class="text-end">

            <span class="badge bg-light
                     text-dark border">

                Auto-refresh:
                10 seconds

            </span>

        </div>

    </div>

    <!-- Summary Cards -->

    <div class="row g-3 mb-4">

        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">
                        Total Sensors
                    </h6>

                    <h2>
                        @Model.TotalSensors
                    </h2>
                </div>
            </div>
        </div>

        @if (Model.DisconnectedSensors > 0)
        {
            <div class="alert alert-danger">

                <strong>
                    🚨 Connectivity Alert:
                </strong>

                @Model.DisconnectedSensors
                sensor(s) are currently disconnected.

                Immediate investigation is recommended.

            </div>
        }

        @if (Model.WarningSensors > 0)
        {
            <div class="alert alert-warning">

                <strong>
                    ⚠ Telemetry Warning:
                </strong>

                @Model.WarningSensors
                sensor(s) require attention due to
                anomalous readings or delayed telemetry.

            </div>
        }

        <div class="col-md-3">
            <div class="card shadow-sm h-100
                        border-success">

                <div class="card-body">
                    <h6 class="text-muted">
                        Connected
                    </h6>

                    <h2 class="text-success">
                        @Model.ConnectedSensors
                    </h2>

                    <span class="badge bg-success">
                        Healthy
                    </span>
                </div>
            </div>
        </div>


        <div class="col-md-3">
            <div class="card shadow-sm h-100
                        border-warning">

                <div class="card-body">
                    <h6 class="text-muted">
                        Warning
                    </h6>

                    <h2 class="text-warning">
                        @Model.WarningSensors
                    </h2>

                    <span class="badge bg-warning text-dark">
                        Attention Required
                    </span>
                </div>
            </div>
        </div>


        <div class="col-md-3">
            <div class="card shadow-sm h-100
                        border-danger">

                <div class="card-body">
                    <h6 class="text-muted">
                        Disconnected
                    </h6>

                    <h2 class="text-danger">
                        @Model.DisconnectedSensors
                    </h2>

                    <span class="badge bg-danger">
                        Offline
                    </span>
                </div>
            </div>
        </div>

    </div>


    <!-- Sensor Health Cards -->
    @if (!Model.Sensors.Any())
    {
        <div class="alert alert-info">

            <h5>
                No sensors registered
            </h5>

            <p class="mb-2">
                Register your first Smart-X sensor
                to begin monitoring telemetry.
            </p>

            <a asp-controller="Sensors"
               asp-action="Register"
               class="btn btn-primary">

                Register Sensor

            </a>

        </div>
    }

    @if (Model.Sensors.Any())
    {
        <div class="row g-4">

            @foreach (var sensor in Model.Sensors)
            {
                // sensor cards here
            }

        </div>
    }

        @foreach (var sensor in Model.Sensors)
        {
            <div class="col-lg-4 col-md-6">

                <div class="card shadow-sm h-100">

                    <div class="card-body">

                        <div class="d-flex
                                        justify-content-between
                                        align-items-start">

                            <div>
                                <h5>
                                    @sensor.DeviceName
                                </h5>

                                <small class="text-muted">
                                    @sensor.MacAddress
                                </small>
                            </div>


                            @if (sensor.Status ==
                                                    "Connected")
                            {
                                <span class="badge
                                                     bg-success">
                                    ● Connected
                                </span>
                            }

                            else if (sensor.Status ==
                            "Warning")
                            {
                                <span class="badge
                                                     bg-warning
                                                     text-dark">
                                    ● Warning
                                </span>
                            }

                            else
                            {
                                <span class="badge
                                                     bg-danger">
                                    ● Disconnected
                                </span>
                            }

                        </div>


                        <hr />


                        <p class="mb-1">
                            <strong>
                                Location:
                            </strong>

                            @sensor.DeploymentLocation
                        </p>

                        <p class="mb-1">
                            <strong>
                                Zone:
                            </strong>

                            @sensor.Zone
                        </p>

                        <p class="mb-1">
                            <strong>
                                Category:
                            </strong>

                            @sensor.Category
                        </p>

                        <p class="mb-3">
                            <strong>
                                Last seen:
                            </strong>

                            @sensor.LastSeen
                            .ToLocalTime()
                            .ToString(
                            "dd MMM yyyy HH:mm:ss")
                        </p>


                        @if (sensor.HasActiveAnomaly)
                        {
                            <div class="alert
                                                alert-warning
                                                mb-0">

                                <strong>
                                    ⚠ Anomaly detected
                                </strong>

                                <br />

                                This device has produced
                                telemetry outside its
                                expected operating range.

                            </div>
                        }


                        @if (sensor.Status ==
                                            "Disconnected")
                        {
                            <div class="alert
                                                alert-danger
                                                mb-0">

                                <strong>
                                    Sensor offline
                                </strong>

                                <br />

                                No telemetry has been
                                received for more than
                                15 minutes.

                            </div>
                        }

                    </div>

                </div>

            </div>
        }

    </div>

</div>

@section Scripts
{
    <script>
        setTimeout(function () {
            window.location.reload();
        }, 10000);
    </script>
}