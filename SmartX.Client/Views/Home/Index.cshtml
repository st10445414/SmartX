@{
    ViewData["Title"] = "Smart-X Gateway";
}

<div class="container py-5">

    <div class="text-center mb-5">

        <h1 class="display-4 fw-bold">
            Smart-X
        </h1>

        <p class="lead">
            Data Ingestion and Validation Gateway
        </p>

        <p class="text-muted">
            Monitor. Validate. Troubleshoot.
        </p>

    </div>

    <div class="row g-4">

        <div class="col-md-4">

            <div class="card h-100 shadow-sm">

                <div class="card-body">

                    <h4>
                        Sensor Data Ingestion
                    </h4>

                    <p class="text-muted">
                        Register IoT devices,
                        ingest telemetry and
                        monitor sensor health.
                    </p>

                    <a asp-controller="Dashboard"
                       asp-action="Index"
                       class="btn btn-primary">

                        Open Gateway

                    </a>

                    <a asp-controller="CommandStream"
                       asp-action="Index"
                       class="btn btn-primary">
                        Open Command Stream
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>